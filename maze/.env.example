# Local: hit API directly. Railway: same-origin via Next rewrites (see next.config.ts).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Server-side rewrite target (not exposed to browser). Local default is baked in next.config.
# API_INTERNAL_URL=http://localhost:4000

# --- Railway checklist (Web service, root = maze) ---
# API_INTERNAL_URL=http://<api-service>.railway.internal:PORT
#   (or public https://<api>.up.railway.app if private networking is unavailable)
# NEXT_PUBLIC_API_BASE_URL=https://<web>.up.railway.app/api/v1
