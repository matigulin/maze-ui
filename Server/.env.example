NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# PostgreSQL
DATABASE_URL=postgres://maze:maze@localhost:5432/maze

# Redis
REDIS_URL=redis://localhost:6379

# JWT (min 32 chars in production)
JWT_SECRET=dev-jwt-secret-change-me-32chars!!
JWT_REFRESH_SECRET=dev-refresh-secret-change-32chars!!

# CORS (через запятую можно несколько; in development также localhost/LAN)
# Railway: https://<web>.up.railway.app
CORS_ORIGIN=http://localhost:3000

# Postgres TLS. Пусто = SSL только в production. Docker Compose (локальный Postgres): false
# DATABASE_SSL=false

# Cookie (production custom domain only, e.g. .maze.ru). Leave empty on *.up.railway.app
COOKIE_DOMAIN=

# Optional integrations (phase 1 can be empty)
SMS_API_KEY=
# Railway preview without SMS provider: AUTH_DEV_OTP=true (shows code in MAZE ID modal)
AUTH_DEV_OTP=
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
YANDEX_DELIVERY_TOKEN=

# Optional local uploads (dev defaults: ./uploads, http://localhost:4000/uploads)
UPLOAD_DIR=
UPLOAD_PUBLIC_URL=

# --- Railway checklist (API service, root = Server) ---
# NODE_ENV=production
# HOST=0.0.0.0
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# REDIS_URL=${{Redis.REDIS_URL}}
# JWT_SECRET=<random >=32>
# JWT_REFRESH_SECRET=<random >=32>
# CORS_ORIGIN=https://<web>.up.railway.app
