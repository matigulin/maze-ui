NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# PostgreSQL
DATABASE_URL=postgres://maze:maze@localhost:5432/maze

# Redis
REDIS_URL=redis://localhost:6379

# JWT (min 32 chars in production)
JWT_SECRET=dev-jwt-secret-change-me-32chars!!
JWT_REFRESH_SECRET=dev-refresh-secret-change-32chars!!

# CORS (через запятую можно несколько; в development дополнительно разрешены localhost/LAN)
CORS_ORIGIN=http://localhost:3000

# Cookie (production: .maze.ru)
COOKIE_DOMAIN=

# Optional integrations (phase 1 can be empty)
SMS_API_KEY=
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
YANDEX_DELIVERY_TOKEN=

# Optional local uploads (dev defaults: ./uploads, http://localhost:4000/uploads)
UPLOAD_DIR=
UPLOAD_PUBLIC_URL=
